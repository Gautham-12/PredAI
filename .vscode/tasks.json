{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Run AURA Dashboard",
      "type": "shell",
      "command": "py -m streamlit run dashboard/app.py",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Run All Tests",
      "type": "shell",
      "command": "py -m unittest discover tests -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "🔧 Run Inference Pipeline (FD001, Engine 1)",
      "type": "shell",
      "command": "py pipelines/inference_pipeline.py --dataset FD001 --engine 1",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
